# Rahasia - jangan pernah di-commit
.env
*.env
!.env.example
docker/.env.old
# Docker secrets (make gen-secrets), termasuk cadangan .env lama
docker/secrets/
# Kode lama (csAdmin, notifEngine, app Flutter csAdmin): berisi kredensial default, hanya referensi lokal
legacy/

# Docker volume lokal (jika ada bind mount)
docker/volumes/db/data/
docker/volumes/storage/
docker/volumes/snippets/*
!docker/volumes/snippets/.gitkeep

# Go
services/auth-bridge/bin/

# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml
coverage/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Token agen uji untuk halaman demo CS (make cs-demo)
scripts/cs-demo/runtime/

# Backup lokal
backups/*
!backups/.gitkeep

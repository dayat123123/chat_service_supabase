# Scripts and configs that run in Linux containers must stay LF even on a Windows checkout.
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
*.ps1 text eol=crlf
*.envsh text eol=lf
*.conf text eol=lf
*.template text eol=lf

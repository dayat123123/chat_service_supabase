############
# OLT Social - konfigurasi stack Docker
#
# Salin & isi rahasia otomatis:   make gen-keys   (Windows: .\make.ps1 gen-keys)
# Semua nilai CHANGE_ME wajib diganti; `make up` menolak jalan jika masih ada.
# JANGAN commit file .env.
############


############
# Rahasia (diisi oleh `make gen-keys`)
############

POSTGRES_PASSWORD=CHANGE_ME
# Minimal 32 karakter. Dipakai GoTrue, PostgREST, Realtime, Storage, dan auth-bridge.
JWT_SECRET=CHANGE_ME
# Kunci publik untuk client (Flutter). Aman di aplikasi.
ANON_KEY=CHANGE_ME
# Kunci admin. TIDAK BOLEH ada di aplikasi Flutter.
SERVICE_ROLE_KEY=CHANGE_ME

# Login Studio (basic-auth di Kong)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME

SECRET_KEY_BASE=CHANGE_ME
# Tepat 16 karakter
REALTIME_DB_ENC_KEY=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME


############
# URL & port
############

# URL publik API gateway. Produksi: https://api.domain-anda.com
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Kong adalah satu-satunya port yang di-expose (API + Studio).
# 127.0.0.1 = hanya bisa diakses dari mesin ini (emulator Android tetap bisa via 10.0.2.2).
# Ganti ke 0.0.0.0 untuk mengetes dari HP fisik di jaringan lokal.
KONG_HTTP_BIND=127.0.0.1
KONG_HTTP_PORT=8000


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Rendezvous
STUDIO_DEFAULT_PROJECT="OLT Social"
# Opsional: aktifkan AI Assistant di Studio
OPENAI_API_KEY=


############
# Auth (GoTrue)
#
# User OLT tidak signup lewat GoTrue. JWT diterbitkan auth-bridge,
# jadi signup publik dimatikan.
############

DISABLE_SIGNUP=true
JWT_EXPIRY=3600
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="OLT Social"


############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions


############
# Storage & imgproxy
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true


############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=true


############
# auth-bridge (token OLT -> JWT Supabase)
############

# development | production. Saat production, OLT_MODE=mock ditolak.
APP_ENV=development

# mock      = token dummy "mock:<olt_user_id>:<username>" (development)
# websocket = verifikasi ke WebSocket server OLT (login metode token)
AUTH_BRIDGE_OLT_MODE=mock
# Contoh: wss://olt.example.com/ws
OLT_WS_URL=
# Timeout verifikasi ke server OLT (detik)
OLT_WS_TIMEOUT=5
# Header Origin saat membuka WebSocket (kosongkan jika tidak perlu)
OLT_WS_ORIGIN=

# --- Format pesan login OLT (sesuaikan dengan protokol OLT) ---
# Template JSON pesan login; {{token}} diganti token OLT.
# Default: {"action":"login","method":"token","token":"{{token}}"}
OLT_WS_LOGIN_TEMPLATE=
# Field respons dibaca dengan path bertitik, mis. "data.user.id" atau "items.0.id".
# Abaikan pesan lain (heartbeat dsb.) sampai field ini bernilai sama (opsional).
OLT_WS_RESPONSE_MATCH_PATH=
OLT_WS_RESPONSE_MATCH_VALUE=
# Login dianggap sukses jika nilai di path ini = value (default: success = true)
OLT_WS_SUCCESS_PATH=
OLT_WS_SUCCESS_VALUE=
# Pesan error saat login ditolak (default: message)
OLT_WS_ERROR_MESSAGE_PATH=
# Data user (default: data.user_id, data.username, data.email, data.name)
OLT_WS_USER_ID_PATH=
OLT_WS_USERNAME_PATH=
OLT_WS_EMAIL_PATH=
OLT_WS_DISPLAY_NAME_PATH=

# Masa berlaku JWT Supabase yang diterbitkan (detik)
AUTH_BRIDGE_JWT_TTL=900
# Lama cache hasil verifikasi token OLT (detik)
AUTH_BRIDGE_CACHE_TTL=60
# Batas request /exchange per IP per menit
AUTH_BRIDGE_RATE_LIMIT_PER_MINUTE=30
AUTH_BRIDGE_LOG_LEVEL=info


############
# Produksi (make up PROD=1) - Caddy + Let's Encrypt
############

# Domain yang DNS A-record-nya mengarah ke VPS. Set juga SUPABASE_PUBLIC_URL
# dan API_EXTERNAL_URL ke https://<domain>.
PROXY_DOMAIN=


############
# OLT dummy (development/testing) - make up DUMMY_OLT=1 (Windows: .\make.ps1 up -DummyOlt)
# Server WebSocket OLT tiruan; auth-bridge memakai mode websocket. Lihat services/dummy-olt.
# Semua opsional (nilai default di docker/docker-compose.dummy-olt.yml).
############

# Port host WebSocket/HTTP OLT dummy (app contoh: ws://localhost:8090/ws)
DUMMY_OLT_PORT=8090
# Kunci HMAC token dummy (bukan rahasia produksi)
DUMMY_OLT_SECRET=dummy-olt-dev-secret-jangan-dipakai-di-produksi
DUMMY_OLT_TOKEN_TTL=24h
# Terima juga token "mock:<id>:<username>" agar tes & tombol mock tetap jalan
DUMMY_OLT_ACCEPT_MOCK_TOKENS=true

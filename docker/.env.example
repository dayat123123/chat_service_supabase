# Non-secret stack configuration. Secrets (DB password, JWT secret, anon/service keys, ...) are not
# here: they live as Docker secrets in docker/secrets/, created by
#     make gen-secrets        (Windows: .\make.ps1 gen-secrets)
# which also creates docker/.env from this file when it does not exist yet.
# Never commit docker/.env or docker/secrets/.
# Empty or commented-out values fall back to the defaults in docker/compose*.yml.

# Single profile: set both to https://<PROXY_DOMAIN>.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Dev: 127.0.0.1 = this machine only (the Android emulator still reaches it via 10.0.2.2).
# Use 0.0.0.0 to test from a physical phone on the local network.
EDGE_HTTP_BIND=127.0.0.1
EDGE_HTTP_PORT=8000

# Comma-separated web origins allowed to call the API. Dev default "*"; single default empty
# (no web origin; native apps do not need CORS).
# CORS_ALLOWED_ORIGINS=https://web.your-domain.com

# Per-IP edge limits (docs/PRODUCTION.md). Defaults are generous because about 1,000 customers can
# share one CGNAT/office Wi-Fi IP.
# EDGE_RATE_AVERAGE=600        # requests/s per IP
# EDGE_RATE_BURST=1200
# EDGE_WS_PER_IP=1500          # concurrent WebSockets per IP (one per customer); at least 1000 in production
# EDGE_BODY_MAX_API=262144
# EDGE_BODY_MAX_UPLOAD=10485760
# Kong trusts X-Forwarded-For only from this subnet. Change it only if it clashes with another
# network on the server.
# EDGE_SUBNET=10.250.250.0/24

# Required for the single profile: a domain whose DNS A record points to this server.
PROXY_DOMAIN=
# Required for the single profile: Let's Encrypt account email (certificate notices).
ACME_EMAIL=
# Trial runs: https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Admin port (Studio, all paths) on the server's 127.0.0.1, for an SSH tunnel or WireGuard.
# ADMIN_PORT=8000

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Apps connect through PgBouncer; `session` mode works with every service.
# PGBOUNCER_POOL_MODE=session
# PGBOUNCER_MAX_CLIENT_CONN=500
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_MAX_DB_CONNECTIONS=80
# Seconds (fractions allowed) before retrying a failed Postgres login. PgBouncer's default of 15
# makes the API reject requests for 15 s after a Postgres restart even when the DB is ready.
# PGBOUNCER_SERVER_LOGIN_RETRY=0.25
# Seconds between DB host IP checks (0 = off). A new IP (db container recreated) is used at once
# instead of waiting for PgBouncer's c-ares DNS cache (up to 600 s).
# PGBOUNCER_DB_WATCH_SECONDS=2

# Studio basic-auth login; the password is in docker/secrets/dashboard_password.
DASHBOARD_USERNAME=supabase
STUDIO_DEFAULT_ORGANIZATION=Rendezvous
STUDIO_DEFAULT_PROJECT="OLT Social"

JWT_EXPIRY=3600

PGRST_DB_SCHEMAS=public,graphql_public,cs_api
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
# Seconds to wait for a pool connection. An exhausted pool fails fast with 504 PGRST003 instead of
# queueing for 10 s.
PGRST_DB_POOL_ACQUISITION_TIMEOUT=2
# -N<n> must equal the CPU limit of the rest service.
PGRST_GHCRTS=-N1

# file = local volume (dev/single). s3 = S3-compatible (SeaweedFS), see docs/scaling.md.
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

# Server folder for the restic repository when a Super Admin picks the "Folder lokal di server"
# destination in the web CS (Pengaturan -> Backup). Mounted at /var/lib/olt-backup-repo in the
# backup container. Relative to docker/; the default ../backups/restic is git-ignored.
# Production: point it at a disk separate from the database disk, e.g. /mnt/backup/restic, owned by
# uid 10001:  sudo install -d -o 10001 -g 10001 -m 0700 /mnt/backup/restic
# A local folder does not survive a lost or broken server: copy it off the server regularly and
# move to S3 once available.
# BACKUP_LOCAL_REPO_DIR=/mnt/backup/restic

# Realtime tenant limits.
# REALTIME_MAX_CONCURRENT_USERS=10000
# Room fan-out ≈ receivers × messages/s to that room (about N²/20 in a busy stock room). 20,000 covers about 630 active receivers per room with a 2 vCPU realtime.
# REALTIME_MAX_EVENTS_PER_SECOND=20000
# REALTIME_MAX_CHANNELS_PER_CLIENT=100
# REALTIME_MAX_JOINS_PER_SECOND=500

FUNCTIONS_VERIFY_JWT=true

# auth-bridge OLT token mode:
# jwt       = OLT-signed social token, verified locally with the OLT public key
#             (default for every profile except dev; auth-bridge never calls OLT)
# mock      = dummy token "mock:<olt_user_id>:<username>" (dev default)
# websocket = legacy: asks the OLT WebSocket server; needs the egress network
#             (services/auth-bridge/README.md)
# AUTH_BRIDGE_OLT_MODE=

# jwt mode (docs/olt-integration.md): the OLT public key is docker/secrets/olt_jwks (JWKS format).
# make gen-secrets fills it with a dummy OLT key for dev. Production: replace it with the JWKS from
# the OLT team; kids starting with "dev-" are rejected when APP_ENV=production.
OLT_JWT_ISSUER=olt
OLT_JWT_AUDIENCE=olt-social
# Maximum accepted social token age (seconds).
OLT_JWT_MAX_TTL=900

# websocket mode is no longer wired in compose; its OLT_WS_* variables and egress override are in
# services/auth-bridge/README.md ("Mode websocket").

# Lifetime of issued Supabase JWTs (seconds).
AUTH_BRIDGE_JWT_TTL=900
# OLT token verification cache (seconds, stored in Valkey per token hash).
AUTH_BRIDGE_CACHE_TTL=60
# /exchange requests per IP per minute, shared by all replicas through Valkey. Must be at least 1000
# in production (about 1,000 customers behind one CGNAT/office IP at peak): `make up` for the
# single/cluster profiles fails when it is lower.
AUTH_BRIDGE_RATE_LIMIT_PER_MINUTE=1500
# /exchange per OLT user per minute after the token is verified (default 10; dev uses 60 because
# tests reuse the same user).
# AUTH_BRIDGE_RATE_LIMIT_PER_USER_PER_MINUTE=10
# Circuit breaker to OLT: opens after N consecutive failures, retries after the cooldown (seconds).
AUTH_BRIDGE_BREAKER_FAILURE_THRESHOLD=5
AUTH_BRIDGE_BREAKER_COOLDOWN=30
# Default: debug (dev), info (single).
# AUTH_BRIDGE_LOG_LEVEL=info

# Web CS (compose profile "cs"): always on in dev; production uses make up PROFILE=single CS=1
# (Windows: -Cs). Dev URL: http://localhost:<CS_CONSOLE_PORT>.
# CS_CONSOLE_PORT=8085
# Rendezvous Hub checkout (github.com/dayat123123/rendezvous_hub) the cs-console image is built from,
# absolute or relative to docker/. Default: ../../rendezvous_hub (next to this repo).
# HUB_DIR=/home/deploy/rendezvous_hub
# Required when CS=1: the one domain for the web CS and agent API, reachable only from the IPs in
# VPN_SOURCE_RANGES (Traefik ipAllowList).
CS_CONSOLE_DOMAIN=
# Required when CS=1: comma-separated IP ranges allowed to open the web CS, i.e. the office LAN
# and/or VPN, e.g. 192.168.1.0/24 or 10.8.0.0/24. Cloud server: the office public IP, e.g. 203.0.113.10/32.
VPN_SOURCE_RANGES=

# Resource limits; size them to the server.
# DB_MEMORY=2G
# KONG_MEMORY=1G
# KONG_WORKER_PROCESSES=2
# REALTIME_MEMORY=1G
# VALKEY_MAXMEMORY=192mb

# Auto-restart (services/healer, dev/single only). Restarts containers labeled olt.autoheal=true that
# are unhealthy (process alive but stuck); Docker already restarts dead ones. All optional; the
# values below are the defaults.
# false = report-only mode: healer only logs what it would restart.
# HEALER_ENABLED=true
# Group owning /var/run/docker.sock. Docker Desktop: 0. Linux: getent group docker | cut -d: -f3
# HEALER_DOCKER_GID=0
# Empty = read from the healer container's own compose label.
# HEALER_PROJECT=
# HEALER_INTERVAL_SECONDS=10
# Seconds a container must stay unhealthy before it is restarted.
# HEALER_UNHEALTHY_SECONDS=60
# Seconds a container must have been running since its last start.
# HEALER_MIN_UPTIME_SECONDS=120
# More restarts than this per service within an hour: healer gives up (critical alert healer:gave_up:<service>).
# HEALER_MAX_RESTARTS_PER_HOUR=3
# Minimum gap between restarts across the whole stack.
# HEALER_GLOBAL_COOLDOWN_SECONDS=30
# Fraction of labeled services unhealthy at once that counts as a systemic outage (restarts held).
# HEALER_SYSTEMIC_FRACTION=0.5
# HEALER_LOG_LEVEL=info

# Dev/testing only: dummy OLT (make up DUMMY_OLT=1, Windows: .\make.ps1 up -DummyOlt), see
# services/dummy-olt. All optional; defaults are in docker/compose.dummy-olt.yml.
# Host port of the dummy OLT WebSocket/HTTP (sample app: ws://localhost:8090/ws).
DUMMY_OLT_PORT=8090
# HMAC key for dummy OLT session tokens; not a production secret.
DUMMY_OLT_SECRET=dummy-olt-dev-secret-jangan-dipakai-di-produksi
DUMMY_OLT_TOKEN_TTL=24h
# Also accept "mock:<id>:<username>" tokens so tests and the mock button keep working.
DUMMY_OLT_ACCEPT_MOCK_TOKENS=true
# Lifetime of issued social tokens (at most OLT_JWT_MAX_TTL).
DUMMY_OLT_SOCIAL_TTL=10m

# Customer Account menu gateway (services/nasabah-gateway, docs/nasabah/README.md). It requests an
# integration token from csAdmin (POST /integration/token) with an Ed25519 assertion signed by
# docker/secrets/csadmin_signing_key (created by gen-secrets), then forwards staff /online/* routes
# only. Put the matching public key in the integration { public_key } block of the CS Admin service
# config. Address and client id are NOT set here: a Super Admin sets them in the web CS (Pengaturan
# -> Integrasi API Nasabah), and the menu appears once both are saved with a passing connection test.
CSADMIN_TIMEOUT=15s

############
# OLT Social - konfigurasi stack Docker (NON-RAHASIA)
#
# Rahasia (password DB, JWT secret, anon/service key, dll.) TIDAK ada di file ini.
# Rahasia disimpan sebagai Docker secrets di docker/secrets/, dibuat oleh:
#     make gen-secrets        (Windows: .\make.ps1 gen-secrets)
# Perintah itu juga membuat docker/.env dari file ini bila belum ada.
# JANGAN commit docker/.env maupun docker/secrets/.
#
# Profil: make up [PROFILE=dev|single]. Nilai kosong/terkomentar memakai default
# di docker/compose*.yml.
############


############
# URL publik
############

# URL publik API gateway (Traefik). Profil single: https://<PROXY_DOMAIN>
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=


############
# Edge (Traefik) - profil dev
############

# Traefik adalah satu-satunya port yang dibuka (API + Studio di dev).
# 127.0.0.1 = hanya mesin ini (emulator Android tetap bisa lewat 10.0.2.2).
# Ganti ke 0.0.0.0 untuk mengetes dari HP fisik di jaringan lokal.
EDGE_HTTP_BIND=127.0.0.1
EDGE_HTTP_PORT=8000

# Origin web yang boleh memanggil API (dipisah koma). Dev default "*".
# Profil single default kosong = tidak ada (app native tidak butuh CORS).
# CORS_ALLOWED_ORIGINS=https://web.domain-anda.com

# Batas edge (docs/PROMPT-PRODUCTION.md bagian 3)
# EDGE_RATE_AVERAGE=100        # request/detik per IP
# EDGE_RATE_BURST=200
# EDGE_WS_PER_IP=20            # koneksi WebSocket bersamaan per IP
# EDGE_BODY_MAX_API=262144     # 256 KB
# EDGE_BODY_MAX_UPLOAD=10485760 # 10 MB
# Subnet network edge (Kong hanya mempercayai X-Forwarded-For dari sini).
# Ganti bila bentrok dengan network lain di server.
# EDGE_SUBNET=10.250.250.0/24


############
# Produksi 1 server (make up PROFILE=single) - Traefik + Let's Encrypt
############

# Domain yang DNS A-record-nya mengarah ke server. Set juga SUPABASE_PUBLIC_URL
# dan API_EXTERNAL_URL ke https://<domain>.
PROXY_DOMAIN=
# Email akun Let's Encrypt (pemberitahuan sertifikat)
ACME_EMAIL=
# Uji coba: https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Port admin (Studio, semua path) di 127.0.0.1 server, untuk SSH tunnel/WireGuard
# ADMIN_PORT=8000


############
# Database & pooler
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Aplikasi konek lewat PgBouncer. Mode `session` kompatibel dengan semua service.
# PGBOUNCER_POOL_MODE=session
# PGBOUNCER_MAX_CLIENT_CONN=500
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_MAX_DB_CONNECTIONS=80


############
# Studio (dev; profil single: make admin-up)
############

# Login basic-auth Studio; password di docker/secrets/dashboard_password
DASHBOARD_USERNAME=supabase
STUDIO_DEFAULT_ORGANIZATION=Rendezvous
STUDIO_DEFAULT_PROJECT="OLT Social"


############
# Auth (GoTrue)
#
# User OLT tidak login lewat GoTrue; JWT diterbitkan auth-bridge. Signup,
# email, dan user anonim selalu mati (diatur di compose.yml).
############

JWT_EXPIRY=3600


############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public,cs_api
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions


############
# Storage & imgproxy
############

# file = volume lokal (dev/single). s3 = S3-compatible (SeaweedFS), lihat docs/scaling.md
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true


############
# Realtime (batas tenant)
############

# REALTIME_MAX_CONCURRENT_USERS=10000
# REALTIME_MAX_EVENTS_PER_SECOND=1000
# REALTIME_MAX_CHANNELS_PER_CLIENT=100
# REALTIME_MAX_JOINS_PER_SECOND=500


############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=true


############
# auth-bridge (token OLT -> JWT Supabase)
############

# mock      = token dummy "mock:<olt_user_id>:<username>" (default profil dev)
# websocket = verifikasi ke WebSocket server OLT (default & wajib di profil single)
# AUTH_BRIDGE_OLT_MODE=
# Endpoint WebSocket OLT yang berbicara Protokol v1 (docs/olt-integration.md).
# Contoh: wss://olt.example.com/social
OLT_WS_URL=
# Timeout verifikasi ke server OLT (detik)
OLT_WS_TIMEOUT=5
# Header Origin saat membuka WebSocket (kosongkan jika tidak perlu)
OLT_WS_ORIGIN=

# --- Format pesan login OLT ---
# KOSONGKAN semua bila OLT memakai Protokol v1 (default). Isi hanya bila format
# OLT berbeda. Field respons dibaca dengan path bertitik, mis. "data.user.id".
# Template JSON pesan login; {{token}} = token OLT, {{request_id}} = UUID per request.
# Default: {"v":1,"type":"login","request_id":"{{request_id}}","method":"token","payload":{"token":"{{token}}"}}
OLT_WS_LOGIN_TEMPLATE=
# Lewati pesan lain (heartbeat dsb.) sampai field ini bernilai sama (default: type = login_result)
OLT_WS_RESPONSE_MATCH_PATH=
OLT_WS_RESPONSE_MATCH_VALUE=
# Login dianggap sukses jika nilai di path ini = value (default: status = OK)
OLT_WS_SUCCESS_PATH=
OLT_WS_SUCCESS_VALUE=
# Pesan error saat login ditolak (default: error.message)
OLT_WS_ERROR_MESSAGE_PATH=
# Data user (default: data.user.id, data.user.username, data.user.email, data.user.full_name)
OLT_WS_USER_ID_PATH=
OLT_WS_USERNAME_PATH=
OLT_WS_EMAIL_PATH=
OLT_WS_DISPLAY_NAME_PATH=

# Masa berlaku JWT Supabase yang diterbitkan (detik)
AUTH_BRIDGE_JWT_TTL=900
# Lama cache hasil verifikasi token OLT (detik, disimpan di Valkey per hash token)
AUTH_BRIDGE_CACHE_TTL=60
# Batas request /exchange per IP per menit (dibagi semua replika lewat Valkey)
AUTH_BRIDGE_RATE_LIMIT_PER_MINUTE=30
# Batas /exchange per user OLT per menit, setelah token terverifikasi
# (default 10; profil dev 60 karena tes memakai user yang sama berulang kali)
# AUTH_BRIDGE_RATE_LIMIT_PER_USER_PER_MINUTE=10
# Circuit breaker ke OLT: terbuka setelah N kegagalan berturut-turut, uji ulang setelah cooldown (detik)
AUTH_BRIDGE_BREAKER_FAILURE_THRESHOLD=5
AUTH_BRIDGE_BREAKER_COOLDOWN=30
# Default: debug (dev), info (single)
# AUTH_BRIDGE_LOG_LEVEL=info


############
# Customer service lewat chat: web CS (profil compose "cs")
# Dev: selalu aktif. Produksi: make up PROFILE=single CS=1 (Windows: -Cs).
############

# Web CS React (apps/cs-console-react). Dev: http://localhost:<CS_CONSOLE_PORT>.
# CS_CONSOLE_PORT=8085
# Produksi (CS=1, docker/compose.cs.yml): satu domain untuk web CS + API agen,
# HANYA bisa diakses dari IP VPN (Traefik ipAllowList). Wajib diisi bila CS=1.
CS_CONSOLE_DOMAIN=
# Rentang IP klien VPN, dipisah koma, mis. 10.8.0.0/24, 10.9.0.0/24
VPN_SOURCE_RANGES=


############
# Batas sumber daya (sesuaikan dengan kapasitas server)
############

# DB_MEMORY=2G
# KONG_MEMORY=1G
# KONG_WORKER_PROCESSES=2
# REALTIME_MEMORY=1G
# VALKEY_MAXMEMORY=192mb


############
# OLT dummy (development/testing) - make up DUMMY_OLT=1 (Windows: .\make.ps1 up -DummyOlt)
# Server WebSocket OLT tiruan; auth-bridge memakai mode websocket. Lihat services/dummy-olt.
# Semua opsional (nilai default di docker/compose.dummy-olt.yml).
############

# Port host WebSocket/HTTP OLT dummy (app contoh: ws://localhost:8090/ws)
DUMMY_OLT_PORT=8090
# Kunci HMAC token dummy (bukan rahasia produksi)
DUMMY_OLT_SECRET=dummy-olt-dev-secret-jangan-dipakai-di-produksi
DUMMY_OLT_TOKEN_TTL=24h
# Terima juga token "mock:<id>:<username>" agar tes & tombol mock tetap jalan
DUMMY_OLT_ACCEPT_MOCK_TOKENS=true
